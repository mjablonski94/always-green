"access.title" = "Wymagany dostęp do Dostępności";
"access.body" = "Kliknij Przyznaj dostęp, włącz „Always Green” na liście, która się otworzy, a następnie kliknij Sprawdź ponownie. Do tego czasu przycisk Uruchom pozostaje nieaktywny.";
"about.what.title" = "Do czego służy";
"about.what.body" = "Always Green wykonuje niewielki ruch kursora w wybranym interwale, aby Twój Mac pozostawał aktywny, a status na czacie „dostępny”. Nie klika, nie pisze, nie nagrywa ani nie odczytuje niczego, co robisz.";
"about.interval.title" = "Interwał";
"about.interval.body" = "Interwał domyślnie wynosi połowę czasu uśpienia ekranu, aby ruch zawsze nastąpił, zanim ekran zaśnie. Jeśli czas uśpienia ekranu przekracza pięć minut (lub jest wyłączony), używana jest bezpieczna wartość 30 sekund. Możesz go zmienić.";
"about.privacy.title" = "Dane i prywatność";
"about.privacy.body" = "Always Green nie zbiera żadnych danych osobowych i nie nawiązuje połączeń sieciowych. Nie zawiera analityki ani śledzenia. Twoje ustawienia są przechowywane tylko na tym Macu. Przycisk „Postaw mi kawę” otwiera odnośnik w przeglądarce; ta strona należy do podmiotu zewnętrznego z własnymi warunkami.";
"about.permissions.title" = "Uprawnienia";
"about.permissions.body" = "Dostęp do Dostępności jest wymagany przez macOS, aby Always Green mógł poruszać kursorem. Przyznajesz go raz w Ustawieniach systemowych i możesz cofnąć w dowolnym momencie. Always Green nigdy nie wymusza czuwania Maca za pomocą asercji zasilania.";
"about.cli.title" = "Wiersz poleceń";
"about.cli.body" = "Dołączone narzędzie „alwaysgreen” steruje tą samą aplikacją z terminala (start, stop, toggle, status).";
"about.responsibility.title" = "Twoja odpowiedzialność";
"about.responsibility.body" = "Odpowiadasz za korzystanie z Always Green zgodnie z zasadami pracodawcy i obowiązującymi przepisami. Symulowanie aktywności może być zabronione w niektórych miejscach pracy.";
"about.warranty.title" = "Gwarancja";
"about.warranty.body" = "Always Green jest dostarczany „tak jak jest”, bez jakiejkolwiek gwarancji. Korzystasz na własne ryzyko.";
